{
  "elements": [
    {
      "type": "ExpansionPanel",
      "caption": "General Settings",
      "items": [
        {
          "type": "Label",
          "caption": "afprivat: both pages always require a new native Secrets passkey session. Legacy authentication modes are inactive."
        },
        {
          "type": "SelectInstance",
          "name": "SecretsInstanceID",
          "caption": "Native Secrets backend (automatic when unique)"
        },
        {
          "type": "CheckBox",
          "name": "WebEnabled",
          "caption": "Enable protected weather and administration pages"
        },
        {
          "type": "CheckBox",
          "name": "AllowWebAdministration",
          "caption": "Allow passkey-authenticated application sessions to change weather settings"
        },
        {
          "type": "Label",
          "caption": "Leave web settings changes off for view/export-only administration. Secrets binding and webhook paths are console settings."
        },
        {
          "type": "SelectInstance",
          "name": "PortalInstanceID",
          "caption": "Portal (automatic when unique)"
        },
        {
          "type": "SelectInstance",
          "name": "DocumentationInstanceID",
          "caption": "Documentation (automatic when unique)"
        },
        {
          "type": "ValidationTextBox",
          "name": "WebhookPath",
          "caption": "Weather page hook path"
        },
        {
          "type": "CheckBox",
          "name": "DebugEnabled",
          "caption": "Write debug log below instance"
        },
        {
          "type": "ValidationTextBox",
          "name": "StationName",
          "caption": "Station Name"
        },
        {
          "type": "ValidationTextBox",
          "name": "ProfilePrefix",
          "caption": "Profile Prefix"
        },
        {
          "type": "SelectInstance",
          "name": "ArchiveID",
          "caption": "Archive Control",
          "validModules": [
            "{43192F0B-135B-4CE7-A0A7-1475603F3060}"
          ]
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Weather tabs / local sources",
      "items": [
        {
          "type": "Label",
          "caption": "Berlin is this instance. Hermitage uses direct numeric children of the local mirror category; Berlin forecast uses the existing downloaded image string. No remote requests are added."
        },
        {
          "type": "SelectCategory",
          "name": "HermitageRootID",
          "caption": "Hermitage mirror category"
        },
        {
          "type": "SelectVariable",
          "name": "ForecastVariableID",
          "caption": "Berlin forecast image (string variable)",
          "validVariableTypes": [
            3
          ]
        },
        {
          "type": "ValidationTextBox",
          "name": "HermitageTimezone",
          "caption": "Hermitage timezone"
        },
        {
          "type": "Select",
          "name": "DefaultWeatherView",
          "caption": "Default weather tab",
          "options": [
            {
              "caption": "Berlin",
              "value": "berlin"
            },
            {
              "caption": "Hermitage",
              "value": "hermitage"
            },
            {
              "caption": "Berlin forecast",
              "value": "forecast"
            }
          ]
        }
      ]
    },
    {
      "type": "Label",
      "caption": "Open the URLs shown in the child WebLinks variable using the native Secrets HTTPS address."
    },
    {
      "type": "ExpansionPanel",
      "caption": "Battery Regression (Experimental)",
      "items": [
        {
          "type": "CheckBox",
          "name": "ExperimentalRegression",
          "caption": "Enable Battery Hysteresis Logic"
        },
        {
          "type": "NumberSpinner",
          "name": "TriggerValueSlope",
          "caption": "Trigger Value Slope (m)",
          "digits": 6
        },
        {
          "type": "NumberSpinner",
          "name": "RegressionDataPoints",
          "caption": "Number of Datapoints",
          "minimum": 5,
          "maximum": 500
        },
        {
          "type": "Label",
          "caption": "⚠️ WARNING: Battery Analytics and Dashboard Charts require Archive Logging to be enabled for the respective variables.",
          "color": "#FF0000"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Variable Selection (Observations)",
      "items": [
        {
          "type": "CheckBox",
          "name": "Var_Wind",
          "caption": "Wind (Avg, Lull, Gust, Dir, Interval)",
          "value": true
        },
        {
          "type": "CheckBox",
          "name": "Var_Air",
          "caption": "Air (Temp, Humidity, Pressure)",
          "value": true
        },
        {
          "type": "CheckBox",
          "name": "Var_Light",
          "caption": "Light (Illuminance, UV, Solar Radiation)",
          "value": true
        },
        {
          "type": "CheckBox",
          "name": "Var_Precip",
          "caption": "Precipitation (Accumulated, Type)",
          "value": true
        },
        {
          "type": "CheckBox",
          "name": "Var_Lightning",
          "caption": "Lightning (Distance, Count)",
          "value": true
        },
        {
          "type": "CheckBox",
          "name": "Var_System",
          "caption": "System (Battery, Report Interval)",
          "value": true
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Variable Selection (Status Messages)",
      "items": [
        {
          "type": "CheckBox",
          "name": "MsgDeviceStatus",
          "caption": "Device Status (Uptime, Voltage, RSSI)",
          "value": true
        },
        {
          "type": "CheckBox",
          "name": "MsgHubStatus",
          "caption": "Hub Status (Radio Stats, Seq, Flags)",
          "value": true
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Dashboard Customization",
      "items": [
        {
          "type": "CheckBox",
          "name": "EnableHTML",
          "caption": "Enable HTML Dashboard"
        },
        {
          "type": "SelectColor",
          "name": "HTMLBackgroundColor",
          "caption": "Background Color"
        },
        {
          "type": "SelectColor",
          "name": "HTMLFontColor",
          "caption": "Font Color"
        },
        {
          "type": "Select",
          "name": "HTMLTimezone",
          "caption": "Dashboard Timezone",
          "options": [
            {
              "caption": "Universal Time (UTC)",
              "value": "UTC"
            },
            {
              "caption": "Germany (Berlin)",
              "value": "Europe/Berlin"
            },
            {
              "caption": "United Kingdom (London)",
              "value": "Europe/London"
            },
            {
              "caption": "Florida (Eastern Time)",
              "value": "America/New_York"
            }
          ]
        },
        {
          "type": "NumberSpinner",
          "name": "HTMLUpdateInterval",
          "caption": "Update Interval (seconds)",
          "minimum": 0
        },
        {
          "type": "NumberSpinner",
          "name": "HTMLChartHeight",
          "caption": "Chart Height (pixels)",
          "minimum": 20,
          "maximum": 500
        },
        {
          "type": "NumberSpinner",
          "name": "HTMLFontSizeValue",
          "caption": "Value Font Size (cqi)",
          "minimum": 1,
          "maximum": 20,
          "digits": 1
        },
        {
          "type": "NumberSpinner",
          "name": "ChartTimeframe",
          "caption": "Chart Timeframe (hours)",
          "minimum": 1,
          "maximum": 168
        },
        {
          "type": "SelectColor",
          "name": "ChartColor",
          "caption": "Chart Line Color"
        },
        {
          "type": "List",
          "name": "HTMLVariableList",
          "caption": "Grid Configuration (Row/Col starts at 1)",
          "add": false,
          "delete": false,
          "sort": {
            "column": "Row",
            "direction": "ascending"
          },
          "columns": [
            {
              "caption": "Variable",
              "name": "Label",
              "width": "180px",
              "readOnly": true
            },
            {
              "caption": "Show",
              "name": "Show",
              "width": "60px",
              "edit": {
                "type": "CheckBox"
              }
            },
            {
              "caption": "Chart",
              "name": "ShowChart",
              "width": "60px",
              "edit": {
                "type": "CheckBox"
              }
            },
            {
              "caption": "Row",
              "name": "Row",
              "width": "80px",
              "edit": {
                "type": "NumberSpinner",
                "minimum": 1,
                "maximum": 150
              }
            },
            {
              "caption": "Col",
              "name": "Col",
              "width": "80px",
              "edit": {
                "type": "NumberSpinner",
                "minimum": 1,
                "maximum": 4
              }
            },
            {
              "caption": "Ident",
              "name": "Ident",
              "width": "0px"
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "onClick": "TMT_SaveSelections($id);",
      "caption": "💾 SAVE DASHBOARD SELECTION"
    },
    {
      "type": "Button",
      "onClick": "TMT_UpdateProfiles($id);",
      "caption": "Update Profiles Now"
    },
    {
      "type": "Button",
      "onClick": "TMT_EnableLogging($id);",
      "caption": "Initialize Required Archive Logging"
    },
    {
      "type": "Button",
      "caption": "Register / repair web pages and Portal links",
      "onClick": "TMT_RunPostApply($id);"
    },
    {
      "type": "Button",
      "caption": "Export configuration",
      "onClick": "TMT_ExportToForm($id);"
    },
    {
      "type": "ValidationTextBox",
      "name": "BackupJSON",
      "caption": "Configuration import / export",
      "multiline": true
    },
    {
      "type": "Button",
      "caption": "Import configuration (web access will be disabled)",
      "onClick": "echo TMT_ImportConfig($id, $BackupJSON);"
    }
  ]
}
